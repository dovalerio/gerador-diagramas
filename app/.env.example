# OpenRouter API — obtenha sua chave em https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Modelo a usar (padrão: Llama 3.3 70B gratuito)
# Outros gratuitos: mistralai/mistral-7b-instruct:free, qwen/qwen-2-7b-instruct:free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Flask
SECRET_KEY=your-secret-key-here
FLASK_ENV=development
